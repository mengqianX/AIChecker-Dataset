# API Keys 配置示例
# 复制此文件为 .env 并填入你的实际 API keys
# .env 文件会被 gitignore，不会被提交到仓库

# Qwen (DashScope) API Key
DASHSCOPE_API_KEY=your-dashscope-api-key-here
# 或使用 OPENAI_API_KEY（兼容）
# OPENAI_API_KEY=your-openai-api-key-here

# Qwen 自定义端点（可选，默认使用 DashScope）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-vl-max

# UI-TARS (HuggingFace Inference Endpoints)
UI_TARS_BASE_URL=https://xxx.inference.endpoints.huggingface.cloud/v1
UI_TARS_MODEL=ByteDance-Seed/UI-TARS-1.5-7B
UI_TARS_API_KEY=your-huggingface-token-here
# 或使用 HF_TOKEN（通用 HuggingFace Token）
# HF_TOKEN=your-huggingface-token-here

# MAI-UI (Tongyi-MAI)
MAI_UI_BASE_URL=https://bgkgog9p754r0x2j.us-east-1.aws.endpoints.huggingface.cloud/v1
MAI_UI_MODEL=Tongyi-MAI/MAI-UI-8B
MAI_UI_API_KEY=your-huggingface-token-here

# 默认后端（qwen, ui-tars, mai-ui）
# COUNT_CHANGE_BACKEND=qwen

# Image Match 性能日志（可选）
# 仅在提供路径时写 CSV；否则不会生成该文件
AICHECKER_IMAGE_MATCH_TIMING_CSV=/Users/xmq/GitHubRepo/AIChecker-Dataset/reports/image_match_timing.csv
# 控制台打印 image_match_timing 行
AICHECKER_IMAGE_MATCH_TIMING_VERBOSE=true
