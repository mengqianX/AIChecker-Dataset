# 复制此文件为 .env 并填入实际值。
# .env 会被 gitignore，不会提交到仓库。

# VLM：所有服务都走 OpenAI-compatible 接口，只配这三项。
# 也可用 AICHECKER_VLM_API_KEY / AICHECKER_VLM_MODEL / AICHECKER_VLM_BASE_URL 覆盖。
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# 示例：Qwen (DashScope)
# OPENAI_API_KEY=your-dashscope-api-key-here
# OPENAI_MODEL=qwen-vl-max
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 示例：UI-TARS
# OPENAI_API_KEY=your-huggingface-token-here
# OPENAI_MODEL=ByteDance-Seed/UI-TARS-1.5-7B
# OPENAI_BASE_URL=https://xxx.inference.endpoints.huggingface.cloud/v1

# 示例：MAI-UI
# OPENAI_API_KEY=your-mai-ui-api-key-here
# OPENAI_MODEL=mai-ui-2b
# OPENAI_BASE_URL=https://mai-ui-2b.openapi-qb.sii.edu.cn/v1

# 用例根目录（vision regression 默认读 {TESTAGENT_ROOT}/testcase/<category>/json）
# 默认即本仓库根目录；一般无需设置。
# TESTAGENT_ROOT=/Users/xmq/GitHubRepo/AIChecker-Dataset

# Image Match 性能日志（可选）
# 仅在提供路径时写 CSV；否则不会生成该文件
AICHECKER_IMAGE_MATCH_TIMING_CSV=/Users/xmq/GitHubRepo/AIChecker-Dataset/reports/image_match_timing.csv
# 控制台打印 image_match_timing 行
AICHECKER_IMAGE_MATCH_TIMING_VERBOSE=true
